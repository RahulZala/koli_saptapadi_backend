NODE_ENV=development
PORT=3000

# Supabase PostgreSQL Database Connection
# Paste your Supabase Connection String (URI) from Project Settings -> Database -> Connection String -> URI
# Example: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:[YOUR-SUPABASE-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Individual Supabase DB Config (Fallback if DATABASE_URL is not set)
DB_HOST=db.[YOUR-PROJECT-REF].supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_supabase_password
DB_NAME=postgres
DB_CONNECTION_LIMIT=10

# Authorization Secret
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay Mode Toggle (1 = Live Mode, 0 = Test Mode)
RAZORPAY_IS_LIVE=1

# Razorpay Live Credentials
RAZORPAY_LIVE_KEY_ID=rzp_live_TKQyGtiD6oymse
RAZORPAY_LIVE_KEY_SECRET=rq7yFCUICsZzcDLYgOGFkKRd

# Razorpay Test Credentials
RAZORPAY_TEST_KEY_ID=rzp_test_SkT5LVPkncrUqu
RAZORPAY_TEST_KEY_SECRET=0g6X1k7Z9q3v5a1u2b0

# Firebase Credentials (Optional for Push Notifications)
FIREBASE_PROJECT_ID=koli-saptpadi
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@koli-saptpadi.iam.gserviceaccount.com
