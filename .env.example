NODE_ENV=development
PORT=3000

# Supabase PostgreSQL Database Connection
# Copy the URI from Supabase Project Settings -> Database -> Connection String -> URI.
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-SUPABASE-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=${SUPABASE_DATABASE_URL}

# Individual Supabase DB Config (used when the URI is not set)
SUPABASE_DB_HOST=db.[YOUR-PROJECT-REF].supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_password
SUPABASE_DB_NAME=postgres
DB_CONNECTION_LIMIT=10

# Authorization Secret
JWT_SECRET=your_jwt_secret_key_here

# ==========================================
# Cloudflare R2 Object Storage Configuration
# ==========================================
# 1 = Live Cloudflare R2 Uploads, 0 = Debug / Mock Mode (local placeholders)
CLOUDFLARE_R2_IS_LIVE=1
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_bucket_name
CLOUDFLARE_R2_PUBLIC_URL=https://pub-yourbucket.r2.dev
 
# ==========================================
# Security & Document Verification
# ==========================================
# 1 = Enforce strict Face >= 70% & Document OCR matching, 0 = Lenient / Dev Test Mode
VERIFICATION_STRICT_MODE=1
# Minimum Face Similarity Match Percentage (0-100)
FACE_SIMILARITY_THRESHOLD=70

# Razorpay Mode Toggle (1 = Live Mode, 0 = Test Mode)
RAZORPAY_IS_LIVE=1

# Razorpay Live Credentials
RAZORPAY_LIVE_KEY_ID=""
RAZORPAY_LIVE_KEY_SECRET=""

# Razorpay Test Credentials
RAZORPAY_TEST_KEY_ID=""
RAZORPAY_TEST_KEY_SECRET=""

# Firebase Credentials (Optional for Push Notifications)
FIREBASE_PROJECT_ID=koli-saptpadi
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@koli-saptpadi.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=

# Wakit WhatsApp OTP Gateway Configuration
# Wakit Mode Toggle (1 = Live Mode, 0 = Test/Debug Mode)
WAKIT_IS_LIVE=1

# Wakit WhatsApp Live Key
WAKIT_LIVE_KEY=""

# Wakit WhatsApp Test Key
WAKIT_TEST_KEY=""

# Base API URL
WAKIT_BASE_URL=https://wakit.in/api/v1

# Optional Master OTP for App Store / Google Play review bypass
MASTER_OTP=


